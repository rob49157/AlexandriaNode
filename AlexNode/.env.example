# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database (Postgres via Prisma — Neon) ────────────────
DATABASE_URL=postgresql://user:password@host/alexandria?sslmode=require

# ─── Blockchain (Base Testnet / Sepolia) — read-only ──────
BASE_TESTNET_RPC_URL=https://sepolia.base.org
TOKEN_CONTRACT_ADDRESS=
LIBRARY_CONTRACT_ADDRESS=
STAKE_CONTRACT_ADDRESS=
RENT_CONTRACT_ADDRESS=
PAYMENT_CONTRACT_ADDRESS=

# ─── Arweave / Irys ───────────────────────────────────────
# devnet = free testnet tokens, data retained ~60 days. mainnet = permanent,
# prepaid, irreversible — every byte costs real treasury funds and cannot be
# deleted. Stay on devnet until the upload flow is proven end to end.
IRYS_NETWORK=devnet                 # devnet | mainnet
IRYS_RPC_URL=https://sepolia.base.org   # Chain RPC for the funding token (Base Sepolia on devnet)
IRYS_WALLET_KEY=                    # Dedicated storage wallet, funded by project treasury
IRYS_GATEWAY_URL=https://gateway.irys.xyz   # Read path for fetching stored ciphertext

# ─── Lit Protocol — Chipotle v3 REST API ──────────────────
# Dashboard: https://dashboard.chipotle.litprotocol.com
# API Docs:  https://api.chipotle.litprotocol.com/core/v1/openapi.json
LIT_API_KEY=                        # Account or usage API key from Lit Dashboard
LIT_PKP_ID=                         # PKP wallet ID (mint via dashboard or POST /create_wallet)
LIT_API_URL=https://api.chipotle.litprotocol.com/core/v1

# ─── AI Validation Service ────────────────────────────────
VALIDATION_SERVICE_URL=http://localhost:8000

# ─── File Upload Limits ───────────────────────────────────
MAX_FILE_SIZE_MB=50
