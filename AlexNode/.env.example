# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database (Postgres via Prisma — Neon) ────────────────
DATABASE_URL=postgresql://user:password@host/alexandria?sslmode=require

# ─── Blockchain (Base Sepolia, chain 84532) — read-only ───
# Comma-separated for automatic failover. The official sepolia.base.org endpoint
# intermittently returns "no backend is currently healthy", so it is listed
# second. Leave unset to use the built-in defaults in config/blockchain.js.
BASE_TESTNET_RPC_URL=https://base-sepolia-rpc.publicnode.com,https://sepolia.base.org

# Contract addresses. Leave BLANK to use the deployed addresses committed in
# abis/*.json (generated by `node scripts/sync-abis.js` from the
# AlexandriaSmartContract Ignition deployment). Set one only to repoint a single
# redeployed contract — a value that disagrees with abis/ is logged as a warning.
TOKEN_CONTRACT_ADDRESS=
LIBRARY_CONTRACT_ADDRESS=
STAKE_CONTRACT_ADDRESS=
RENT_CONTRACT_ADDRESS=
PAYMENT_CONTRACT_ADDRESS=

# ─── Registrar wallet (the backend's ONLY write path) ─────
# AlexandriaLibrary.registerUpload() is `onlyAuthorized` and takes an explicit
# `uploader`, so an archivist cannot call it from their own wallet. The backend
# registers on their behalf; the archivist still stakes from their own wallet
# (stake.stake requires getUploader(hash) == msg.sender).
#
# This key can ONLY call registerUpload. It cannot stake, rent, move $ALEX,
# resolve challenges, or blacklist — so a compromise means spam registrations,
# not stolen funds. Never make this address a contract owner or the treasury.
#
# Leave BACKEND_PRIVATE_KEY blank to keep the backend fully read-only: uploads
# still succeed and stay at status "pending_stake", retryable via
# POST /api/upload/:hash/register.
#
# Setup:
#   1. Owner runs:  library.setAuthorizedCaller("<BACKEND_WALLET_ADDRESS>", true)
#   2. Fund the address with Base Sepolia ETH for gas
#   3. Check readiness:  GET /api/upload/registrar/status
BACKEND_WALLET_ADDRESS=             # Optional but recommended — asserted against
                                    # the key below so a wrong key fails loudly
                                    # instead of reverting "Not authorized"
BACKEND_PRIVATE_KEY=                # 0x-prefixed. Blank = registration disabled

# ─── Event listener ───────────────────────────────────────
EVENT_LISTENER_ENABLED=true         # false = run the API without chain syncing
CHAIN_POLL_INTERVAL_MS=12000        # How often to look for new logs
CHAIN_CONFIRMATIONS=3               # Blocks to stay behind the head (reorg buffer)
CHAIN_LOG_CHUNK=10000               # getLogs span; publicnode caps at 50k, drpc ~10k
# CHAIN_START_BLOCK=                # Defaults to the earliest contract deployment
                                    # block recorded in abis/. Set higher to skip
                                    # history on a fresh index.

# ─── Arweave L1 (direct, no bundler) ──────────────────────
# Direct uploads to raw Arweave nodes, no bundler and no gateway (ARWEAVE-DIRECT-PLAN.md).
# Setup: node scripts/arweave-wallet-setup.js generate | status   (Node >= 22)
#
# Dedicated storage wallet — NOT the registrar, NOT a personal wallet. A local
# RSA JWK file (gitignored). No seed phrase: the file IS the wallet; back it up.
ARWEAVE_WALLET_FILE=.arweave-wallet.json
ARWEAVE_WALLET_ADDRESS=             # 43 base64url chars. Asserted against the file;
                                    # an 0x EVM address is rejected by name
# Raw nodes for writes. Blank = discover peers via GET /peers on the seeds and
# health-check each one. Set to pin nodes (e.g. our own node, Option B); there is
# then no fallback to discovery.
ARWEAVE_NODE_URLS=
ARWEAVE_PEER_SEEDS=                 # blank = built-in raw seed nodes (no gateway); asked ONLY for peer addresses
ARWEAVE_PEER_CACHE_FILE=.arweave-peers.json   # last healthy nodes; refreshes the seeds (gitignored)
ARWEAVE_GATEWAY_URLS=               # optional extra read sources; blank = raw nodes only
ARWEAVE_CONFIRMATIONS=16            # before an upload counts as stored (D2); whole number >= 1
ARWEAVE_MIN_HOLDERS=2               # independent nodes we copy the chunks to and verify (D9)
ARWEAVE_REWARD_MARGIN_PERCENT=0     # % above the network quote (0-100); a higher fee is accepted (Q7)
STORAGE_WORKER_ENABLED=true         # false = accept uploads but do not store them (they wait at pending_confirmation)
STORAGE_WORKER_INTERVAL_MS=30000    # how often the worker checks pending uploads
ARWEAVE_MAX_REWARD_AR=3             # most one upload may pay. Price = median of 3 node
                                    # quotes, refused above this. 150 MiB ≈ 2.02 AR (2026-10-11)
ARWEAVE_SPOOL_DIR=.arweave-spool    # ciphertext awaiting chunk upload (gitignored)

# ─── Lit Protocol — Chipotle v3 REST API ──────────────────
# Dashboard: https://dashboard.chipotle.litprotocol.com
# API Docs:  https://api.chipotle.litprotocol.com/core/v1/openapi.json
LIT_API_KEY=                        # Upload key: seals keys in group 1. Never the account key.
LIT_PKP_ID=                         # PKP wallet ID (mint via dashboard or POST /create_wallet)
LIT_API_URL=https://api.chipotle.litprotocol.com/core/v1

# Reader unlocks — POST /api/rental/unlock/:arweaveHash relays signed requests to the
# decryption Lit Action (KEY-BINDING.md R3/R4). Both blank = the route answers 503.
LIT_READER_API_KEY=                 # usage key that may execute in the decrypt group ONLY,
                                    # with no manage/add/remove rights. Not LIT_API_KEY.
LIT_DECRYPT_ACTION_CID=             # the registered decrypt Action's CID (npm run lit:register in
                                    # the frontend prints it). Any other code is refused.
UNLOCK_ALLOWED_DOMAINS=localhost:5173   # must match UNLOCK_ALLOWED_DOMAINS in the Action
UNLOCK_RATE_PER_WALLET=3            # unlocks per wallet per window (~1 cent of Lit credit each).
                                    # Keep it well below the hourly ceiling: any uploader is a
                                    # wallet with access, so one wallet must not take every share.
UNLOCK_RATE_WINDOW_MINUTES=10
UNLOCK_RATE_GLOBAL_PER_HOUR=60      # forwarded Lit calls per hour, all wallets together
UNLOCK_RATE_GLOBAL_PER_DAY=300      # and per day: bounds what reads can spend unattended (~$3)
UNLOCK_MIN_CREDIT_CENTS=100         # stop unlocks (and warn) below this Lit credit, so uploads can
                                    # still seal keys. 0 disables. Read from /billing/balance.

# ─── Upload limits (services/uploadQuota.service.js) ──────
# Alexandria pays each book's Arweave fee up front, before the archivist stakes.
# Uploads are signed by the archivist's wallet, so these apply to a proven wallet.
UPLOAD_MAX_AWAITING_STAKE=3         # per wallet: uploads stored or being stored with no stake
                                    # yet. Staking one frees its slot.
UPLOAD_MAX_PER_WALLET_PER_DAY=10    # per wallet, in any 24 hours (failed uploads do not count)
UPLOAD_DAILY_BUDGET_AR=3            # storage fees in any 24 hours, ALL wallets together: the only
                                    # limit new wallets cannot dodge. Keep it ≥ ARWEAVE_MAX_REWARD_AR,
                                    # or a maximum-size book can never be uploaded.

# ─── AI Validation Service ────────────────────────────────
VALIDATION_SERVICE_URL=http://localhost:8000

# ─── File Upload Limits ───────────────────────────────────
MAX_FILE_SIZE_MB=150
