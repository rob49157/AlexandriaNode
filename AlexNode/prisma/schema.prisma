datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Replaces MongoDB Upload Schema
model Upload {
  arweaveHash       String   @id // Primary Key (mapped to original identifier)
  // keccak256(utf8(arweaveHash)), 0x-prefixed hex.
  //
  // Every book-scoped contract event declares `string indexed arweaveHash`.
  // Solidity cannot fit a variable-length string into a 32-byte log topic, so it
  // emits the keccak256 digest and drops the plaintext — the hash is genuinely
  // not in the log. keccak256 is one-way, so the event listener cannot decode it;
  // it has to match forwards, from a hash it already knows to the topic it would
  // produce. This column is that join key, written at upload time.
  //
  // Nullable only so the column could be added to an existing table; every row
  // this backend writes populates it. See config/blockchain.js topicForHash().
  arweaveHashTopic  String?  @unique
  title             String
  author            String
  category          String
  description       String
  uploader          String   // Wallet address
  uploadTimestamp   DateTime @default(now())
  // "pending_stake" on creation — the file is on Arweave but the archivist has
  // not yet staked/registered on-chain. The event listener (Phase 6) advances it
  // to "pending" once UploadRegistered fires.
  status            String   // "pending_stake" | "pending" | "challenged" | "approved" | "rejected"
  fileSize          Int      // Bytes (of the original PDF, not the ciphertext)
  pageCount         Int?     // From Layer 1 pdf-parse
  sha256Hash        String   @unique // Unique index for exact duplicate detection
  simHash           String   // For near-duplicate detection reference
  // The PKP-sealed symmetric key. This is the actual ciphertext handed to the
  // decryption Lit Action — lose it and the file is unrecoverable, so it is
  // persisted rather than merely referenced.
  litEncryptedKeyId String
  // Lit's integrity hash for the sealed payload; the decrypt call needs it
  // alongside the ciphertext above.
  litDataToEncryptHash String?
  onChainTxHash     String?  // Transaction hash of on-chain registration (optional initially)

  // AES-256-GCM decryption parameters. Also written to the Arweave tags, which
  // are the authoritative copy — these exist so the read path can serve them
  // without a gateway round-trip. Without them the ciphertext is unrecoverable.
  encryptionIv      String   // base64, 12 bytes
  encryptionAuthTag String   // base64, 16 bytes

  // Layer 3 near-duplicate outcome. Soft flag — never blocks an upload, but
  // surfaces the row for librarian review.
  isNearDuplicate   Boolean  @default(false)
  nearDuplicateOf   String?  // arweaveHash of the closest match, if any

  // Banded LSH prefilter for near-duplicate lookup. Each column holds one
  // 16-bit slice of simHash, most-significant first. A candidate must match at
  // least one band, which is a lossless filter for Hamming distance <= 3.
  // Column count is tied to BAND_COUNT in services/simhash.service.js — adding
  // a band here requires changing that constant (and vice versa).
  simHashBand0      Int      @default(0)
  simHashBand1      Int      @default(0)
  simHashBand2      Int      @default(0)
  simHashBand3      Int      @default(0)

  @@index([title, author]) // Index for search queries
  // One index per band so Postgres can bitmap-OR the four equality lookups.
  @@index([simHashBand0])
  @@index([simHashBand1])
  @@index([simHashBand2])
  @@index([simHashBand3])
}

// On-chain events, mirrored into Postgres by services/eventListener.service.js.
//
// Append-only audit log. The chain stays the source of truth — this table exists
// so the frontend can read history without an archive node, and so a status the
// listener applied to Upload can be traced back to the log that caused it.
model Event {
  id              Int      @id @default(autoincrement())
  eventName       String   // "UploadRegistered", "Staked", "BookRented", ...
  contract        String   // "library" | "stake" | "rent"

  // Plaintext hash when the listener could resolve the topic to a known book,
  // null when it could not. Nullable because the log only carries the digest:
  // an event for a book registered outside this backend is still worth
  // recording, and can be resolved later once the hash is known.
  arweaveHash     String?
  // The keccak256 topic exactly as emitted. Always present for book-scoped
  // events, and the only durable link back to the log when arweaveHash is null.
  arweaveHashTopic String?

  args            Json     // Decoded, non-indexed event arguments
  blockNumber     Int
  logIndex        Int
  transactionHash String
  timestamp       DateTime

  // Idempotency. A restarted listener re-scans an overlapping block range on
  // purpose, and a chain reorg can re-deliver logs; (txHash, logIndex) uniquely
  // identifies a log, so re-processing upserts instead of duplicating.
  @@unique([transactionHash, logIndex])
  @@index([arweaveHash])
  @@index([arweaveHashTopic])
  @@index([blockNumber])
}

// Listener cursor — how far the event listener has caught up.
//
// A separate table rather than max(Event.blockNumber) because blocks containing
// no Alexandria events still count as processed. Deriving the cursor from the
// last *stored* event would re-scan every quiet block on every restart.
model SyncState {
  id                 String   @id // "chain-84532"
  lastProcessedBlock Int
  updatedAt          DateTime @updatedAt
}
